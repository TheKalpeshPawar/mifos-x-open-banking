<resources>
    <string name="feature_callback_loading_title">Verifying your authorisation…</string>
    <string name="feature_callback_loading_body">Securely exchanging credentials with HSBC. This takes a few seconds.</string>

    <string name="feature_callback_connected_title">Connected to HSBC</string>
    <string name="feature_callback_connected_body">Your account data is ready. Taking you to your accounts now.</string>

