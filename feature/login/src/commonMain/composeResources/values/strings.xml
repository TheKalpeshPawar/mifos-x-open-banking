<resources>
    <!-- Intro (first page of the auth flow) -->
    <string name="feature_login_intro_headline">Share your HSBC data securely with Open Banking</string>
    <string name="feature_login_intro_body">UK Open Banking is regulated under the Payment Services Regulations 2017, with providers authorised by the Financial Conduct Authority. It lets you share your account information with authorised apps — without sharing your password.</string>
    <string name="feature_login_fapi_chip">Secured by FAPI 1.0 Advanced</string>
    <string name="feature_login_fca_chip">FCA Regulated</string>
    <string name="feature_login_intro_continue">Continue</string>

    <!-- Loading -->
    <string name="feature_login_connecting">Connecting to HSBC…</string>

    <!-- Content -->
    <string name="feature_login_hsbc_brand">HSBC</string>
    <string name="feature_login_ob_badge">UK Open Banking</string>
    <string name="feature_login_explainer_headline">You will be taken to HSBC to sign in</string>
    <string name="feature_login_explainer_body">HSBC will ask you to confirm which accounts to share. Once you approve, you will be returned here automatically. Your HSBC credentials are never shared with Mifos.</string>
    <string name="feature_login_security_notice">Secured with FAPI 1.0 Advanced</string>
